@model IEnumerable<Notely.Models.Note>

@{
    ViewData["Title"] = "My Notes";
}

<div class="container mt-page">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-5">

        <h2 class="fw-bold">
            <i class="bi bi-journals me-2 text-primary"></i>
            My Notes
        </h2>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                New Note
            </a>

            <a asp-action="Public" class="btn btn-outline-danger">
                <i class="bi bi-globe me-1"></i>
                View Public Notes
            </a>
        </div>


    </div>

    <!-- Search -->
    <div class="d-flex justify-content-center mb-5">

        <form method="get"
              asp-action="@ViewContext.RouteData.Values["action"]"
              class="search-wrapper position-relative">

            <i class="bi bi-search search-icon"></i>

            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   class="form-control search-input"
                   placeholder="Search your notes..." />

        </form>

    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">

            <i class="bi bi-journal-x display-1 text-secondary"></i>

            <h3 class="mt-3">No Notes Yet</h3>

            <p class="text-muted">
                Create your first note to start organizing your ideas.
            </p>

            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>
                Create Note
            </a>

        </div>
    }
    else
    {
        <div class="notes-grid">

            @foreach (var note in Model)
            {
                 var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                bool isOwner = currentUserId != null && note.UserId == int.Parse(currentUserId);

                <div class="note-card">

                    <!-- Image -->
                    @if (!string.IsNullOrEmpty(note.ImagePath))
                    {
                        <div class="note-image-wrapper">

                            <img src="@note.ImagePath"
                                 class="note-image"
                                 alt="@note.Title" />

                        </div>
                    }

                    <!-- Body -->
                    <div class="card-body d-flex flex-column">

                        <h5 class="note-title">
                            @note.Title
                        </h5>

                        <p class="note-content">
                            @(note.Content.Length > 100
                                ? note.Content.Substring(0, 100) + "..."
                                : note.Content)
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-auto">

                            <span class="note-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                @note.CreatedAt.ToShortDateString()
                            </span>

                            @if (note.State)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-globe2 me-1"></i>
                                    Public
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Private
                                </span>
                            }

                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="card-footer bg-transparent border-0">

                        @if (isOwner)
                        {
                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                       asp-route-id="@note.Id"
                                       class="btn btn-outline-primary btn-sm flex-fill">

                                    <i class="bi bi-pencil-square me-1"></i>
                                    Edit

                                </a>

                                <a asp-action="Details"
                                       asp-route-id="@note.Id"
                                       class="btn btn-outline-info btn-sm flex-fill">

                                    <i class="bi bi-eye me-1"></i>
                                    View

                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@note.Id"
                                       class="btn btn-outline-danger btn-sm flex-fill">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete

                                </a>

                            </div>
                        }
                        else
                        {
                            <a asp-action="Details"
                                   asp-route-id="@note.Id"
                                   class="btn btn-outline-info btn-sm w-100">

                                <i class="bi bi-eye me-1"></i>
                                View Only

                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>