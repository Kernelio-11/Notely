@model Notely.Models.LoginViewModel;

@{
    ViewData["Title"] = "Login";;
}

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-logo">
            <i class="bi bi-journal-bookmark-fill"></i>
        </div>

        <h3 class="text-center mb-1" style="font-weight:800;">Welcome Back</h3>
        <p class="text-center mb-4" style="color:var(--text-muted);font-size:var(--font-size-sm);">
            Sign in to access your notes
        </p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="All" class="alert-danger mb-4"></div>

            <!-- Email -->
            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email address</label>
                <div class="position-relative">
                    <i class="bi bi-envelope" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;"></i>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com"
                           style="padding-left:40px;" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="position-relative">
                    <i class="bi bi-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;"></i>
                    <input asp-for="Password" class="form-control" placeholder="••••••••"
                           style="padding-left:40px;" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Remember Me -->
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
            </div>

            <!-- Submit -->
            <div class="d-grid mt-1">
                <button type="submit" class="btn btn-primary btn-lg w-100 d-flex justify-content-center align-items-center gap-2">
                    <i class="bi bi-person-plus"></i>
                    <span>Sign In</span>
                </button>
            </div>

            <!-- Register link -->
            <p class="text-center mb-2" style="font-size:var(--font-size-sm);color:var(--text-muted);">
                Don&rsquo;t have an account?
                <a asp-action="Register" style="font-weight:600;">Create one &rarr;</a>
            </p>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}