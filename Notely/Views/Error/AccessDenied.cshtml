@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-page">
    <div class="empty-state text-center py-5">
        <i class="bi bi-shield-lock display-1 text-secondary"></i>
        <h3 class="mt-3">Access Denied</h3>
        <p class="text-muted">
            You don’t have permission to view this page.
        </p>
        <div class="d-flex justify-content-center gap-2 mt-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-house-door me-1"></i>
                Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Sign In
            </a>
        </div>
    </div>
</div>
