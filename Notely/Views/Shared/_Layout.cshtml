@using Microsoft.AspNetCore.Identity
@inject SignInManager<Notely.Models.ApplicationUser> SignInManager
@inject UserManager<Notely.Models.ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var firstName = user?.FirstName ?? "User";
    var profileImage = !string.IsNullOrEmpty(user?.ProfileImagepath)
        ? user.ProfileImagepath
        : "/imgs/default.jpg";
    var isAdmin = string.Equals(user?.Role, "Admin", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Notely</title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Notely design system -->
    <link rel="stylesheet" href="~/css/theme.css"      asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css"       asp-append-version="true" />
    <link rel="stylesheet" href="~/Notely.styles.css"  asp-append-version="true" />

    <!-- Apply saved theme before first paint to prevent flash of unstyled theme.
         theme-toggle.js (loaded in body) handles the toggle interaction. -->
    <script>
        (function () {
            var t = localStorage.getItem('notely-theme');
            if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>

<body>

    <!-- ═══════════════════════════════════ NAVBAR ═════════════════════════════════════ -->
    <header>
        <nav class="navbar navbar-expand-sm notely-navbar">
            <div class="container-fluid px-5">

                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-journal-bookmark-fill"></i></span>
                    <span>Notely</span>
                </a>

                <!-- Mobile controls (theme toggle + hamburger) -->
                <div class="d-flex align-items-center gap-2 d-sm-none ms-auto">
                    <button class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
                        <i class="theme-icon bi bi-moon-fill"></i>
                    </button>
                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Collapsible nav -->
                <div class="navbar-collapse collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-sm-center gap-1">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <!-- My Notes shortcut -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notes" asp-action="Index">
                                    <i class="bi bi-journals me-1"></i>My Notes
                                </a>
                            </li>

                            <!-- User dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link avatar-trigger dropdown-toggle"
                                   href="#" data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <img src="@(user?.ProfileImagepath ?? "/imgs/default.jpg")"
                                         class="avatar-img" alt="@firstName" />
                                    <span class="fw-600 hide-mobile">@firstName</span>
                                </a>

                                <div class="dropdown-menu dropdown-menu-end notely-dropdown text-center">
                                    <img src="@(user?.ProfileImagepath ?? "/imgs/default.jpg")"
                                         class="dropdown-avatar mb-3" alt="@user?.FirstName @user?.LastName" />
                                    <h6 class="mb-0 fw-700">@user?.FirstName @user?.LastName</h6>
                                    <p class="text-muted mb-3" style="font-size:12px">@user?.Email</p>

                                    <hr />

                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-circle"></i> My Profile
                                    </a>

                                    <a class="dropdown-item" asp-controller="Notes" asp-action="Index">
                                        <i class="bi bi-journals"></i> My Notes
                                    </a>

                                    @if (isAdmin)
                                    {
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-shield-check"></i> Admin Dashboard
                                        </a>
                                    }

                                    <hr />

                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger w-100 border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-1"
                                   asp-controller="Account" asp-action="Register">
                                    Get Started
                                </a>
                            </li>
                        }

                        <!-- Theme toggle (desktop) -->
                        <li class="nav-item d-none d-sm-flex align-items-center ms-2">
                            <button class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
                                <i class="theme-icon bi bi-moon-fill"></i>
                            </button>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- ═══════════════════════════════════ CONTENT ════════════════════════════════════ -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- ═══════════════════════════════════ FOOTER ═════════════════════════════════════ -->
    <footer class="notely-footer">
        <div class="container">
            <p class="mb-1">
                <i class="bi bi-journal-bookmark-fill me-1" style="color:var(--color-primary)"></i>
                <strong>Notely</strong> &mdash; Your thoughts, beautifully organised.
            </p>
            <p class="mb-0">&copy; @DateTime.Now.Year Notely. All rights reserved.</p>
        </div>
    </footer>

    <!-- ═══════════════════════════════════ SCRIPTS ════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/site.js"         asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
