@{
    ViewData["Title"] = "Home";
}

<!-- ── Hero ──────────────────────────────────────────────────────── -->
<section class="hero-section home-hero">
    <div class="container">
        <div class="hero-badge mb-4">
            <i class="bi bi-stars me-1"></i> Your personal note space
        </div>
        <h1>Capture Every<br><span class="hero-highlight">Brilliant Idea</span></h1>
        <p class="hero-sub">
            Save, organise, and access your notes from anywhere.<br>
            Keep your thoughts beautifully structured with Notely.
        </p>

        <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">
            <a asp-controller="Notes" asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle-fill me-2"></i>Create New Note
            </a>
            <a asp-controller="Notes" asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-journals me-2"></i>View My Notes
            </a>
        </div>
    </div>
</section>

<!-- ── Features ──────────────────────────────────────────────────── -->
<section class="container mb-5">
    <div class="section-label text-center mb-5">
        <span class="section-tag">What you get</span>
        <h2 class="section-title">Everything you need,<br>nothing you don't</h2>
    </div>

    <div class="feature-grid">

        <a asp-controller="Notes" asp-action="Index" class="feature-card">
            <div class="feature-icon feature-icon-primary">
                <i class="bi bi-pin-angle-fill"></i>
            </div>
            <h5 class="mb-2">Organise</h5>
            <p class="mb-0" style="font-size:var(--font-size-sm);">Keep all your notes in one tidy place, always at your fingertips.</p>
        </a>

        <a asp-controller="Notes" asp-action="Private" class="feature-card">
            <div class="feature-icon feature-icon-success">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h5 class="mb-2">Private</h5>
            <p class="mb-0" style="font-size:var(--font-size-sm);">Your notes stay secure and private — visible only to you.</p>
        </a>

        <a asp-controller="Notes" asp-action="Public" class="feature-card">
            <div class="feature-icon feature-icon-accent">
                <i class="bi bi-globe2"></i>
            </div>
            <h5 class="mb-2">Share Publicly</h5>
            <p class="mb-0" style="font-size:var(--font-size-sm);">Optionally publish notes so anyone can read your ideas.</p>
        </a>

    </div>
</section>

<!-- ── How it works ───────────────────────────────────────────────── -->
<section class="how-it-works-section">
    <div class="container">
        <div class="section-label text-center mb-5">
            <span class="section-tag">Simple by design</span>
            <h2 class="section-title">Up and running<br>in seconds</h2>
        </div>

        <div class="steps-grid">
            <div class="step-item">
                <div class="step-number">01</div>
                <h5>Create an account</h5>
                <p>Sign up for free in under a minute — no credit card required.</p>
            </div>
            <div class="step-divider"><i class="bi bi-arrow-right"></i></div>
            <div class="step-item">
                <div class="step-number">02</div>
                <h5>Write your notes</h5>
                <p>Jot down ideas, to-dos, or long-form thoughts with a simple editor.</p>
            </div>
            <div class="step-divider"><i class="bi bi-arrow-right"></i></div>
            <div class="step-item">
                <div class="step-number">03</div>
                <h5>Access anywhere</h5>
                <p>Your notes are always available from any device, any time.</p>
            </div>
        </div>
    </div>
</section>

<!-- ── CTA ────────────────────────────────────────────────────────── -->
<section class="cta-section">
    <div class="container">
        <div class="cta-card">
            <i class="bi bi-journal-bookmark-fill cta-icon"></i>
            <h2 class="mb-3">Ready to get started?</h2>
            <p class="mb-5">Join thousands of people who use Notely to capture their best ideas.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus-fill me-2"></i>Get started for free
            </a>
        </div>
    </div>
</section>
