@model Notely.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-page admin-dashboard">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold">
            <i class="bi bi-shield-check me-2 text-primary"></i>
            Admin Dashboard
        </h2>
        <span class="text-muted" style="font-size:var(--font-size-sm);">
            Manage users and notes
        </span>
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-warning mb-4" role="alert">
            @TempData["AdminMessage"]
        </div>
    }

    <!-- Users -->
    <div class="form-card admin-dashboard-card p-4 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-700 mb-0">Users</h5>
            <span class="text-muted" style="font-size:var(--font-size-sm);">
                @Model.Users.Count total
            </span>
        </div>

        @if (!Model.Users.Any())
        {
            <div class="empty-state text-center py-4">
                <i class="bi bi-people display-6 text-secondary"></i>
                <p class="text-muted mb-0 mt-2">No users found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive admin-dashboard-table-wrap">
                <table class="table align-middle mb-0 admin-dashboard-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Joined</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(user.ProfileImagepath ?? "/imgs/default.jpg")"
                                             class="avatar-img" alt="@user.FirstName" />
                                        <span class="admin-cell-text">@user.FirstName @user.LastName</span>
                                    </div>
                                </td>
                                <td class="admin-cell-email">@user.Email</td>
                                <td>
                                    <span class="badge bg-secondary">@user.Role</span>
                                </td>
                                <td>@user.Created_at.ToShortDateString()</td>
                                <td class="text-end">
                                    <form asp-action="DeleteUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Delete this user and all their notes?')">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Notes -->
    <div class="form-card admin-dashboard-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-700 mb-0">Notes</h5>
            <span class="text-muted" style="font-size:var(--font-size-sm);">
                @Model.Notes.Count total
            </span>
        </div>

        @if (!Model.Notes.Any())
        {
            <div class="empty-state text-center py-4">
                <i class="bi bi-journal-x display-6 text-secondary"></i>
                <p class="text-muted mb-0 mt-2">No notes found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive admin-dashboard-table-wrap">
                <table class="table align-middle mb-0 admin-dashboard-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Owner</th>
                            <th>Visibility</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model.Notes)
                        {
                            <tr>
                                <td class="admin-cell-title">@note.Title</td>
                                <td class="admin-cell-owner">@note.User?.FirstName @note.User?.LastName</td>
                                <td>
                                    @if (note.State)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-globe2 me-1"></i>
                                            Public
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-lock-fill me-1"></i>
                                            Private
                                        </span>
                                    }
                                </td>
                                <td>@note.CreatedAt.ToShortDateString()</td>
                                <td class="text-end">
                                    <form asp-action="DeleteNote" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@note.Id" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Delete this note?')">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
